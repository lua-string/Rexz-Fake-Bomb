local function createPalette(titleText, startY, isBomb)
    makeLabel(titleText, startY, 24)

    for i, info in ipairs(colors) do
        local row = math.floor((i - 1) / 5)
        local col = (i - 1) % 5

        local button = Instance.new("TextButton")
        button.Name = info.Name ..
            (isBomb and "BombColor" or "EffectColor")
        button.Size = UDim2.fromOffset(39, 34)
        button.Position = UDim2.fromOffset(
            col * 45, startY + 28 + row * 40
        )
        button.BackgroundColor3 = info.Color
        button.Text = ""
        button.Parent = panel

        Instance.new("UICorner", button).CornerRadius = UDim.new(0, 8)

        local outline = Instance.new("UIStroke")
        outline.Color = WHITE
        outline.Thickness = 1
        outline.Parent = button

        button.Activated:Connect(function()
            if isBomb then
                bombColor = info.Color
                recolorBombs()
                status.Text = "Bomb color: " .. info.Name
            else
                effectColor = info.Color
                status.Text = "Effect color: " .. info.Name
            end
            status.TextColor3 = Color3.fromRGB(70, 110, 58)
        end)
    end
end

