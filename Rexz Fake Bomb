-- PANEL ANIMATION
local openPosition = UDim2.new(1, -275, 0.5, -185)
local closedPosition = UDim2.new(1, 275, 0.5, -185)

local function setPanel(state)
    if animating or opened == state then return end

    opened = state
    animating = true
    toggle.Text = state and ">" or "<"

    local tween = TweenService:Create(
        panel,
        TweenInfo.new(0.32, Enum.EasingStyle.Quint,
            Enum.EasingDirection.Out),
        {Position = state and openPosition or closedPosition}
    )

    tween:Play()
    tween.Completed:Connect(function()
        animating = false
    end)
end

toggle.Activated:Connect(function()
    setPanel(not opened)
end)

close.Activated:Connect(function()
    setPanel(false)
end)

