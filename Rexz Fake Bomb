local function findCoil(name)
    local backpack = player:FindFirstChildOfClass("Backpack")
    local character = player.Character
    return (backpack and backpack:FindFirstChild(name))
        or (character and character:FindFirstChild(name))
end

local function createCoil(kind)
    local name = kind .. " Coil"
    if findCoil(name) then return false end

    local isSpeed = kind == "Speed"
    local color = isSpeed
        and Color3.fromRGB(235, 65, 65)
        or Color3.fromRGB(65, 145, 255)

    local tool = Instance.new("Tool")
    tool.Name = name
    tool.ToolTip = "Equip to activate " .. name
    tool.RequiresHandle = true
    tool.CanBeDropped = false

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.4, 1.2, 0.4)
    handle.Shape = Enum.PartType.Cylinder
    handle.Color = color
    handle.Material = Enum.Material.SmoothPlastic
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    -- Spring-like colored coils
    for i = 1, 12 do
        local angle = i * math.pi * 0.8
        local y = -0.5 + (i - 1) * 0.09

        local segment = Instance.new("Part")
        segment.Name = "SpringSegment"
        segment.Shape = Enum.PartType.Ball
        segment.Size = Vector3.new(0.22, 0.22, 0.22)
        segment.Color = color
        segment.Material = Enum.Material.SmoothPlastic
        segment.CanCollide = false
        segment.Massless = true
        segment.CFrame = handle.CFrame * CFrame.new(
            math.cos(angle) * 0.25,
            y,
            math.sin(angle) * 0.25
        )
        segment.Parent = tool

        local weld = Instance.new("WeldConstraint")
        weld.Part0 = handle
        weld.Part1 = segment
        weld.Parent = segment
    end

    local equipped = false
    local activeHumanoid
    local previousSpeed
    local previousGravity

    local function deactivate()
        if not equipped then return end
        equipped = false

        if isSpeed then
            if activeHumanoid and activeHumanoid.Parent then
                activeHumanoid.WalkSpeed = previousSpeed or 16
            end
        else
            workspace.Gravity = previousGravity or 196.2
        end

        activeHumanoid = nil
    end

    tool.Equipped:Connect(function()
        local character = player.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if not humanoid or humanoid.Health <= 0 then return end

        equipped = true
        activeHumanoid = humanoid

        if isSpeed then
            previousSpeed = humanoid.WalkSpeed
            humanoid.WalkSpeed = coilSettings.Speed
        else
            previousGravity = workspace.Gravity
            workspace.Gravity = coilSettings.Gravity
        end
    end)

    tool.Unequipped:Connect(deactivate)
    tool.Destroying:Connect(deactivate)

    tool.Parent = player:WaitForChild("Backpack")
    return true
end

local function removeCoil(kind)
    local name = kind .. " Coil"
    local tool = findCoil(name)
    if tool then tool:Destroy() end
    coilTools[name] = false
end

local function addCoil(kind)
    local name = kind .. " Coil"
    if findCoil(name) then return false end
    if createCoil(kind) then
        coilTools[name] = true
        return true
    end
    return false
end

