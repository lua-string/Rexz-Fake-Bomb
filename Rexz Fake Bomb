local function restoreTools()
    if restoring then return end
    restoring = true

    task.spawn(function()
        local character = player.Character or player.CharacterAdded:Wait()
        player:WaitForChild("Backpack")
        task.wait(1)

        if player.Character == character then
            createBombTool()

            for name, enabled in pairs(coilTools) do
                if enabled and not findCoil(name) then
                    createCoil(name:gsub(" Coil", ""))
                end
            end
        end

        restoring = false
    end)
end

restoreTools()

player.CharacterAdded:Connect(function()
    restoreTools()
end)

task.spawn(function()
    while player.Parent do
        task.wait(2)

        local character = player.Character
        local humanoid = character
            and character:FindFirstChildOfClass("Humanoid")

        if character and humanoid and humanoid.Health > 0 then
            if not findCoil("Speed Coil") and coilTools["Speed Coil"] then
                addCoil("Speed")
            end
            if not findCoil("Gravity Coil") and coilTools["Gravity Coil"] then
                addCoil("Gravity")
            end
            if not findCoil("Gold Fake Bomb") then
                createBombTool()
            end
        end
    end
end)

